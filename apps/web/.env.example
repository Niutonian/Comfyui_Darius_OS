# Server-side URL used by the default same-origin Next.js rewrite proxy.
DARIUS_API_URL=http://127.0.0.1:8000

# Recommended: keep browser requests same-origin through the rewrite.
NEXT_PUBLIC_DARIUS_API_BASE_URL=/api/darius/api/v1

# Optional direct browser access (requires this origin in backend DARIUS_CORS_ORIGINS):
# NEXT_PUBLIC_DARIUS_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional extra hostnames/IPs for next dev, comma-separated (no scheme).
DARIUS_ALLOWED_DEV_ORIGINS=
