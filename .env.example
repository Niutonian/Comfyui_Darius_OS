# Backend persistence
DARIUS_DATA_DIR=./data
DARIUS_DATABASE_URL=sqlite:///./data/darius.db
DARIUS_MAX_UPLOAD_BYTES=1073741824

# Direct browser access is optional; the default web app uses a same-origin proxy.
DARIUS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Local ComfyUI / MCP execution
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Optional model-download credentials for first-use board setup. Keep them local.
HF_TOKEN=
CIVITAI_API_KEY=
COMFYUI_OUTPUT_DIR=C:/path/to/ComfyUI/output
COMFY_WORKFLOW_ROOT=C:/path/to/ComfyUI/user/default/workflows
# Optional managed Darius defaults. Files named Darius_*.json are preferred
# during workflow discovery; custom ComfyUI workflows remain available.
DARIUS_WORKFLOW_DEFAULTS_DIR=./workflows/defaults
COMFY_MCP_COMMAND=C:/path/to/comfy.exe
COMFY_MCP_ARGS=
COMFY_JOB_TIMEOUT_SECONDS=2400

# Optional paid LLM providers. Leave keys blank for no-paid-call local development.
# Select one conversational provider: ollama, llamacpp, openai, deepseek, or opencode.
DARIUS_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
# Native Ollama request budget (input + reply). Ornith defaults to 32K.
OLLAMA_CONTEXT_TOKENS=16384
# Optional per-model overrides; measure VRAM before increasing.
OLLAMA_MODEL_CONTEXTS={"ornith-1.5:9b":32768,"ornith-1.5:35b":32768}
# Release only idle ComfyUI model caches under the GPU lease; never cancel jobs.
OLLAMA_UNLOAD_IDLE_COMFY=true
# llama-server should use --jinja --reasoning-budget 0 --sleep-idle-seconds 1.
# Idle sleep releases its RAM/VRAM before a local ComfyUI render starts.
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=unsloth/Qwen3.5-9B-GGUF:Q6_K
LLAMACPP_SLEEP_TIMEOUT_SECONDS=30
# Opt-in for large local profiles: free idle local ComfyUI caches before chat.
LLAMACPP_UNLOAD_IDLE_COMFY=false
# Maximum time a chat or render waits for exclusive access to the local GPU.
OLLAMA_GPU_WAIT_SECONDS=3600
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=
# Optional reasoning effort; saved AI settings take precedence. Use auto for model default.
OPENAI_REASONING_EFFORT=auto
DEEPSEEK_API_KEY=
# Current DeepSeek Responses models include deepseek-flash and deepseek-v4-pro.
# Use deepseek-flash when Talk must inspect project images.
DEEPSEEK_MODEL=
# Optional cloud voice transport remains OpenAI-specific and independent of DARIUS_LLM_PROVIDER.
OPENAI_LIVE_MODEL=gpt-live-1
BFL_API_KEY=
BFL_API_BASE_URL=https://api.bfl.ai/v1

# Local media tools and optional local model adapters
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TTS_PROVIDER=
TTS_MODEL_PATH=
TRANSCRIPTION_PROVIDER=faster-whisper
TRANSCRIPTION_MODEL=
TRANSCRIPTION_MODEL_PATH=
# faster-whisper is the default and runs on CPU. Set TRANSCRIPTION_PROVIDER=r2t2
# only when the optional Confucius4-R2T2 Docker service is running.
R2T2_WS_URL=ws://127.0.0.1:8272/asr_stream_api_v1
R2T2_LANGUAGE=English
R2T2_SECRET_KEY=test0102
R2T2_CONTEXT=

# Optional local speech service installed by scripts/setup-voice.ps1
TTS_SERVICE_URL=http://127.0.0.1:8002
